[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 <IP_ADMIN_1> <IP_ADMIN_2> <IP_ADMIN_3>
destemail = contact@example.org
bantime = 900
maxretry = 5
findtime = 900

[plesk-apache]
enabled = true
maxretry = 3
bantime = 31536000

[plesk-apache-badbot]
enabled = true
bantime = 31536000

[plesk-courierimap]

[plesk-dovecot]

[plesk-horde]

[plesk-modsecurity]
bantime = 31536000
enabled = true
maxretry = 1

[plesk-panel]
enabled = true

[plesk-postfix]

[plesk-proftpd]
bantime = 2629800
enabled = true

[plesk-qmail]

[plesk-roundcube]

[plesk-wordpress]
enabled = true
maxretry = 3
bantime = 900

[recidive]
enabled = true
bantime = 31536000
maxretry = 5

[ssh]
bantime = 157680000
enabled = true
maxretry = 1

[murmur]
enabled = true
filter = murmur
action = iptables[name=murmur, port=64738]
logpath = /var/log/mumble-server/mumble-server.log
bantime = 105192000
maxretry = 3


#!/bin/sh
# postrm — canal de distribution .deb d'Argus.
# remove : le code seul. /srv/argus (historique collecté) et /etc/argus
#          (configuration) sont conservés : une réinstallation propre est
#          possible sans perdre l'historique.
# purge  : supprime aussi /srv/argus et /etc/argus.
#
# Aucun groupe système à gérer ici (abandonné en v1.0.0) : /srv/argus est
# root:root 755 avec des fichiers lisibles de tous, par choix, car rien de ce
# qu'il contient n'est sensible (aucune adresse IP individuelle, seulement des
# totaux quotidiens).
set -e

case "$1" in
    purge)
        rm -rf /srv/argus
        rm -rf /etc/argus
        ;;
esac

#DEBHELPER#

exit 0
